# Optional web-only overrides.
# Prefer managing shared keys in root ../.env
OPENAI_API_KEY=sk-...
# Optional fallback only.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ... # required for Auth; anon/publishable key only
SUPABASE_SERVICE_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... # public anon/publishable key only
NEXT_PUBLIC_MCP_URL=https://civil-mcp-server.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CIVILMCP_OPEN_ACCESS=true
CIVILMCP_OPEN_ACCESS=true
# Open Access removes payment gates; every demo feature still requires an authenticated owner.
NEXT_PUBLIC_CIVILMCP_REQUIRE_AUTH=true
NEXT_PUBLIC_CIVILMCP_FEATURE_EXPLORE_ENABLED=true
NEXT_PUBLIC_CIVILMCP_FEATURE_EXPLORE_REQUIRES_AUTH=true
NEXT_PUBLIC_CIVILMCP_FEATURE_CHAT_ENABLED=true
NEXT_PUBLIC_CIVILMCP_FEATURE_CHAT_REQUIRES_AUTH=true
NEXT_PUBLIC_CIVILMCP_FEATURE_WORKSPACE_ENABLED=true
NEXT_PUBLIC_CIVILMCP_FEATURE_WORKSPACE_REQUIRES_AUTH=true
NEXT_PUBLIC_CIVILMCP_FEATURE_RESEARCH_PATH_ENABLED=true
NEXT_PUBLIC_CIVILMCP_FEATURE_RESEARCH_PATH_REQUIRES_AUTH=true
NEXT_PUBLIC_CIVILMCP_FEATURE_HISTORY_ENABLED=true
NEXT_PUBLIC_CIVILMCP_FEATURE_HISTORY_REQUIRES_AUTH=true
NEXT_PUBLIC_CIVILMCP_FEATURE_SHARE_ENABLED=true
NEXT_PUBLIC_CIVILMCP_FEATURE_SHARE_REQUIRES_AUTH=true
MCP_URL=https://civil-mcp-server.vercel.app
MCP_SERVER_API_KEY=replace-with-mcp-server-secret
GUEST_SESSION_HMAC_KEY=replace-with-random-hmac-secret
CHAT_GUEST_REQUESTS_PER_MINUTE=3
CHAT_GUEST_REQUESTS_PER_HOUR=30
CHAT_AUTH_REQUESTS_PER_MINUTE=10
CHAT_AUTH_REQUESTS_PER_HOUR=60
HISTORY_MAX_BODY_BYTES=220000
HISTORY_MAX_MESSAGES=80
TRACE_CONTENT_MODE=metadata
TRACE_RETENTION_DAYS=30
FEEDBACK_CONTENT_RETENTION_DAYS=30
CRON_SECRET=replace-with-random-cron-secret
# Optional server-only global metadata discovery. Never expose as NEXT_PUBLIC_*.
OPENALEX_API_KEY=
# Explicit low-volume Challenge fallback; use a free server-side key for sustained traffic.
OPENALEX_ALLOW_ANONYMOUS=false
FEDERATED_DISCOVERY_ENABLED=true
OPENALEX_TIMEOUT_SECONDS=8
CIVILMCP_AUTOMATION_EVENT_KEY=
# Dormant billing integration. Never expose these as NEXT_PUBLIC_*.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_FOUNDER_PRO_PRICE_ID=price_...
MODEL=gpt-5.6-luna
AGENTIC_CONTEXT_ENABLED=true
FAST_RETRIEVAL_ENABLED=true
FAST_RETRIEVAL_MAX_RESULTS=6
LLM_ROUTER_ENABLED=false
ROUTER_PROVIDER=openai
ROUTER_MODEL=gpt-5.6-luna
ROUTER_TIMEOUT_MS=6000
ANSWER_TIMEOUT_MS=35000
MCP_TOOL_TIMEOUT_MS=18000
TRANSLATION_MODEL=gpt-5.6-luna
TRANSLATION_GUEST_REQUESTS_PER_MINUTE=2
TRANSLATION_GUEST_REQUESTS_PER_HOUR=10
TRANSLATION_AUTH_REQUESTS_PER_MINUTE=5
TRANSLATION_AUTH_REQUESTS_PER_HOUR=30
WORKSPACE_GENERATION_TIMEOUT_MS=40000
CHECKPOINT_TIMEOUT_MS=15000
PATH_PLANNING_TIMEOUT_MS=18000
MAX_ACTIVE_PATH_BUILDS=8
MAX_ACTIVE_CHECKPOINTS=6
TRANSLATION_MAX_INPUT_CHARS=18000
MAX_AGENT_STEPS=3
MAX_TOOL_CALLS=4
MAX_CONTEXT_CHUNKS=8
MAX_CONTEXT_TOKENS=8000
SIMPLE_RAG_FALLBACK=true
