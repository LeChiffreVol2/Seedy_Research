# Optional web-only overrides.
# Prefer managing shared keys in root ../.env
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
NEXT_PUBLIC_MCP_URL=https://civil-mcp-server.vercel.app
MCP_URL=https://civil-mcp-server.vercel.app
MCP_SERVER_API_KEY=replace-with-mcp-server-secret
MODEL=gpt-5-mini-2025-08-07
