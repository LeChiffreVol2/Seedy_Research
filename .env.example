# =========================
# Civil MCP Project (Single source of truth)
# Copy to: /Users/lechiffre/Desktop/Civil_MCP/.env
# =========================

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
# Allowed chat models: gpt-5-mini-2025-08-07 | gpt-5-nano | deepseek-v4-flash | deepseek-v4-pro
MODEL=gpt-5-mini-2025-08-07
EMBED_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
OPENAI_TIMEOUT_SECONDS=20

# ---- DeepSeek ----
# Server-side only. Never expose as NEXT_PUBLIC_*.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Supabase ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # server-side only, never expose to browser
SUPABASE_ANON_KEY=eyJ...      # optional for browser/public usage
# Optional admin connection (for auto-apply schema via `python supabase/recheck.py --apply`)
# SUPABASE_DB_URL=postgresql://postgres:<db-password>@<db-host>:5432/postgres?sslmode=require

# ---- MCP server ----
# Generate with: openssl rand -hex 32
MCP_SERVER_API_KEY=change-me
REQUIRE_TOOL_AUTH=true
TOOL_TIMEOUT_SECONDS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CALLS=60
LOG_LEVEL=INFO
RETRIEVAL_VERSION=v2
SECTION_TOP_K=20
CHUNK_TOP_K=8
CONTEXT_MAX_CHUNKS=8
AGENTIC_CONTEXT_ENABLED=true
ROUTER_PROVIDER=deepseek
ROUTER_MODEL=deepseek-v4-flash
MAX_AGENT_STEPS=3
MAX_TOOL_CALLS=4
MAX_CONTEXT_CHUNKS=8
MAX_CONTEXT_TOKENS=8000
SIMPLE_RAG_FALLBACK=true
AUTO_COMPACT_ENABLED=true
MEMORY_COMPACT_TRIGGER_PERCENT=75
MEMORY_MIN_MESSAGES=12
MEMORY_RECENT_MESSAGES=8
MEMORY_MAX_SUMMARY_CHARS=2600
MEMORY_MAX_COMPACTION_INPUT_TOKENS=16000
# Optional override if a selected model/provider has a different safe context window.
# MODEL_CONTEXT_WINDOW_TOKENS=64000

# ---- Runtime URLs ----
MCP_URL=http://localhost:8000
NEXT_PUBLIC_MCP_URL=http://localhost:8000

# ---- Optional pipeline overrides ----
INDEXING_MODE=batch
CHUNK_SIZE=700
CHUNK_OVERLAP=80
SECTION_CONTENT_MAX_CHARS=6000
MIN_CHUNK_CHARS=80
EMBED_BATCH_SIZE=50
BATCH_POLL_SECONDS=10
MAX_BATCH_REQUESTS=10000
MAX_BATCH_ESTIMATED_TOKENS=2000000
MAX_BATCH_INPUTS_PER_REQUEST=64
MAX_BATCH_REQUEST_ESTIMATED_TOKENS=100000
PDF_SOURCE_DIR="/Users/lechiffre/Desktop/Civil_MCP/CE Project Database"
NCCE_PDF_SOURCE_DIR="/Users/lechiffre/Desktop/Civil_MCP/NCCE Project Database"
# MD_DIR=/Users/lechiffre/Desktop/Civil_MCP/pipeline/data/markdown

# ---- Chat API guardrails ----
CHAT_MAX_BODY_BYTES=180000
CHAT_MAX_MESSAGES=80
CHAT_MAX_MESSAGE_CHARS=12000
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_MAX_CALLS=24
ANSWER_MAX_TOKENS=1500
FEEDBACK_RATE_LIMIT_WINDOW_SECONDS=60
FEEDBACK_RATE_LIMIT_MAX_CALLS=30
# Optional cost estimate only; leave blank if pricing is tracked elsewhere.
CHAT_COST_INPUT_PER_1K_USD=
CHAT_COST_OUTPUT_PER_1K_USD=

# ---- Ops dashboard ----
# In production, dashboard fails closed unless these are set.
OPS_DASHBOARD_BASIC_AUTH_USER=
OPS_DASHBOARD_BASIC_AUTH_PASSWORD=
# Local development only.
OPS_DASHBOARD_AUTH_DISABLED=false
OPS_RBAC_POLICY_JSON=
OPS_E2E_BASE_URL=http://localhost:3001
OPS_INGEST_SECRET=
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to GET /api/ops/ingest/refresh.
CRON_SECRET=
SMART_CITY_AUTO_REFRESH_SECONDS=300
SMART_CITY_LAYER_MAX_FEATURES=1200
SMART_CITY_TILE_MAX_FEATURES=5000
SMART_CITY_TILE_MAX_ZOOM=16

# ---- Harness SLOs ----
HARNESS_EVAL_P95_LATENCY_MS=45000
HARNESS_EVAL_MAX_LATENCY_MS=60000
HARNESS_EVAL_MAX_COST_USD_PER_ANSWER=0.05
HARNESS_EVAL_MAX_TOTAL_COST_USD=1.00
HARNESS_ENFORCE_SLO=false
