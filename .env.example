# =========================
# Civil MCP Project (single source of truth)
# Copy to: .env
# =========================

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
# OpenAI-first defaults. DeepSeek remains an optional server-side fallback.
# Allowed chat models: gpt-5.6-luna | gpt-5.6-terra | gpt-5.6-sol | deepseek-v4-flash | deepseek-v4-pro
MODEL=gpt-5.6-luna
EMBED_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=1
EMBEDDING_CIRCUIT_SECONDS=300

# ---- DeepSeek ----
# Optional fallback. Server-side only. Never expose as NEXT_PUBLIC_*.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Supabase ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # server-side only, never expose to browser
TNRR_API_TOKEN=             # server-side only; issued bearer token for metadata connector
SUPABASE_ANON_KEY=eyJ...      # required for Auth; must be an anon/publishable key, never service-role
# Required by the browser-based OAuth consent page. These are public project identifiers, never service-role values.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Optional admin connection (for auto-apply schema via `python supabase/recheck.py --apply`)
# SUPABASE_DB_URL=postgresql://postgres:<db-password>@<db-host>:5432/postgres?sslmode=require

# ---- MCP server ----
CIVILMCP_OPEN_ACCESS=true
# Generate with: openssl rand -hex 32
MCP_SERVER_API_KEY=change-me
# MCP server only. Values may be raw secrets or sha256:<hex>; use one key per consumer.
# MCP_CLIENT_KEYS_JSON={"civilmcp-web":"sha256:<hex>","citymcp-ops":"sha256:<hex>","harness":"sha256:<hex>"}
# MCP_WEB_API_KEY_SHA256=<sha256-of-dedicated-civilmcp-web-key>
REQUIRE_TOOL_AUTH=true
MCP_DISTRIBUTED_RATE_LIMIT=true
MCP_PUBLIC_URL=https://civil-mcp-server.vercel.app/v2/mcp
MCP_DOCUMENTATION_URL=https://seedresearch.vercel.app/developers
# Enable only after Supabase OAuth Server + dynamic registration + the CivilMCP audience hook are active.
MCP_OAUTH_ENABLED=false
MCP_OAUTH_AUDIENCE=https://civil-mcp-server.vercel.app/v2/mcp
TOOL_TIMEOUT_SECONDS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CALLS=240
LOG_LEVEL=INFO
RETRIEVAL_VERSION=v2
SECTION_TOP_K=20
CHUNK_TOP_K=8
CONTEXT_MAX_CHUNKS=8
AGENTIC_CONTEXT_ENABLED=true
FAST_RETRIEVAL_ENABLED=true
FAST_RETRIEVAL_MAX_RESULTS=6
LLM_ROUTER_ENABLED=false
ROUTER_PROVIDER=openai
ROUTER_MODEL=gpt-5.6-luna
TRANSLATION_MODEL=gpt-5.6-luna
MAX_AGENT_STEPS=3
MAX_TOOL_CALLS=4
MAX_CONTEXT_CHUNKS=8
MAX_CONTEXT_TOKENS=8000
SIMPLE_RAG_FALLBACK=true
AUTO_COMPACT_ENABLED=true
MEMORY_COMPACT_TRIGGER_PERCENT=75
MEMORY_MIN_MESSAGES=12
MEMORY_RECENT_MESSAGES=8
MEMORY_MAX_SUMMARY_CHARS=2600
MEMORY_MAX_COMPACTION_INPUT_TOKENS=16000
# Optional override if a selected model/provider has a different safe context window.
# MODEL_CONTEXT_WINDOW_TOKENS=1050000

# ---- Runtime URLs ----
MCP_URL=http://localhost:8000
NEXT_PUBLIC_MCP_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CIVILMCP_OPEN_ACCESS=true
# Open Access removes payment gates; every demo feature still requires an authenticated owner.
NEXT_PUBLIC_CIVILMCP_REQUIRE_AUTH=true
NEXT_PUBLIC_CIVILMCP_FEATURE_EXPLORE_ENABLED=true
NEXT_PUBLIC_CIVILMCP_FEATURE_EXPLORE_REQUIRES_AUTH=true
NEXT_PUBLIC_CIVILMCP_FEATURE_CHAT_ENABLED=true
NEXT_PUBLIC_CIVILMCP_FEATURE_CHAT_REQUIRES_AUTH=true
NEXT_PUBLIC_CIVILMCP_FEATURE_WORKSPACE_ENABLED=true
NEXT_PUBLIC_CIVILMCP_FEATURE_WORKSPACE_REQUIRES_AUTH=true
NEXT_PUBLIC_CIVILMCP_FEATURE_RESEARCH_PATH_ENABLED=true
NEXT_PUBLIC_CIVILMCP_FEATURE_RESEARCH_PATH_REQUIRES_AUTH=true
NEXT_PUBLIC_CIVILMCP_FEATURE_HISTORY_ENABLED=true
NEXT_PUBLIC_CIVILMCP_FEATURE_HISTORY_REQUIRES_AUTH=true
NEXT_PUBLIC_CIVILMCP_FEATURE_SHARE_ENABLED=true
NEXT_PUBLIC_CIVILMCP_FEATURE_SHARE_REQUIRES_AUTH=true

# ---- Dormant billing integration ----
# Open Access ignores plan and credit gates. Keep Stripe secrets server-side if billing is re-enabled later.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_FOUNDER_PRO_PRICE_ID=price_...

# ---- Optional global research discovery ----
# Server-only. Explicit global discovery falls back to an OpenAlex search link when absent.
OPENALEX_API_KEY=
# Challenge/demo bridge only. Set true explicitly to use OpenAlex's small
# anonymous allowance when no key is configured; keep false for normal production scale.
OPENALEX_ALLOW_ANONYMOUS=false
# Kill switch. Discovery is enabled unless this is exactly false.
FEDERATED_DISCOVERY_ENABLED=true
OPENALEX_TIMEOUT_SECONDS=8

# Optional server-only marker for separating smoke/eval product events from human traffic.
CIVILMCP_AUTOMATION_EVENT_KEY=

# ---- Optional pipeline overrides ----
INDEXING_MODE=batch
CHUNK_SIZE=700
CHUNK_OVERLAP=80
SECTION_CONTENT_MAX_CHARS=6000
MIN_CHUNK_CHARS=80
EMBED_BATCH_SIZE=50
BATCH_POLL_SECONDS=10
MAX_BATCH_REQUESTS=10000
MAX_BATCH_ESTIMATED_TOKENS=2000000
MAX_BATCH_INPUTS_PER_REQUEST=64
MAX_BATCH_REQUEST_ESTIMATED_TOKENS=100000
PDF_SOURCE_DIR="CE Project Database"
NCCE_PDF_SOURCE_DIR="NCCE Project Database"
# MD_DIR=pipeline/data/markdown

# ---- Chat API guardrails ----
GUEST_SESSION_HMAC_KEY=change-me
# Optional separate HMAC keys; defaults to GUEST_SESSION_HMAC_KEY.
# RATE_LIMIT_HASH_KEY=change-me
# TRACE_HASH_KEY=change-me
CHAT_MAX_BODY_BYTES=180000
CHAT_MAX_MESSAGES=80
CHAT_MAX_MESSAGE_CHARS=12000
CHAT_GUEST_REQUESTS_PER_MINUTE=3
CHAT_GUEST_REQUESTS_PER_HOUR=30
CHAT_AUTH_REQUESTS_PER_MINUTE=10
CHAT_AUTH_REQUESTS_PER_HOUR=60
HISTORY_MAX_BODY_BYTES=220000
HISTORY_MAX_MESSAGES=80
TRACE_CONTENT_MODE=metadata
TRACE_RETENTION_DAYS=30
FEEDBACK_CONTENT_RETENTION_DAYS=30
TRANSLATION_GUEST_REQUESTS_PER_MINUTE=2
TRANSLATION_GUEST_REQUESTS_PER_HOUR=10
TRANSLATION_AUTH_REQUESTS_PER_MINUTE=5
TRANSLATION_AUTH_REQUESTS_PER_HOUR=30
WORKSPACE_GENERATION_TIMEOUT_MS=40000
CHECKPOINT_TIMEOUT_MS=15000
PATH_PLANNING_TIMEOUT_MS=18000
MAX_ACTIVE_PATH_BUILDS=8
MAX_ACTIVE_CHECKPOINTS=6
TRANSLATION_MAX_INPUT_CHARS=18000
ANSWER_MAX_TOKENS=1500
ROUTER_TIMEOUT_MS=6000
ANSWER_TIMEOUT_MS=35000
MCP_TOOL_TIMEOUT_MS=18000
FEEDBACK_RATE_LIMIT_WINDOW_SECONDS=60
FEEDBACK_RATE_LIMIT_MAX_CALLS=30
# Optional cost estimate only; leave blank if pricing is tracked elsewhere.
CHAT_COST_INPUT_PER_1K_USD=
CHAT_COST_OUTPUT_PER_1K_USD=

# ---- Harness SLOs ----
HARNESS_EVAL_P95_LATENCY_MS=25000
HARNESS_EVAL_MAX_LATENCY_MS=30000
HARNESS_EVAL_CONTEXT_P95_MS=8000
HARNESS_EVAL_MAX_COST_USD_PER_ANSWER=0.05
HARNESS_EVAL_MAX_TOTAL_COST_USD=1.00
HARNESS_ENFORCE_SLO=false
# Required by strict preview/promotion gates when the ignored local corpus is not present in CI.
CORPUS_FINGERPRINT=
HARNESS_MAX_REPORT_AGE_HOURS=24
