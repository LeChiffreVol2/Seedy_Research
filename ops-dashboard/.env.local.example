# Smart City Ops Dashboard
# Copy to ops-dashboard/.env.local for local-only overrides.

# Keep this app isolated from the production chatbot under ../web.
OPS_DASHBOARD_ENV=local
SMART_CITY_DEFAULT_REGION=bangkok

# Read-only CivilMCP access. Do not use browser-exposed NEXT_PUBLIC_* keys here.
MCP_URL=http://localhost:8000
MCP_SERVER_API_KEY=replace-with-random-secret

# Server-side Supabase persistence for controlled action records.
# Required on Vercel. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
OPS_ACTION_LOG_BACKEND=supabase

# Protected server-side spatial ingest. Never expose this as NEXT_PUBLIC_*.
OPS_INGEST_SECRET=replace-with-random-ingest-secret
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to GET /api/ops/ingest/refresh.
CRON_SECRET=replace-with-random-cron-secret
OPS_RBAC_POLICY_JSON=
OPS_E2E_BASE_URL=http://localhost:3001
SMART_CITY_INGEST_BATCH_LIMIT=500
SMART_CITY_AUTO_REFRESH_SECONDS=300
SMART_CITY_LAYER_MAX_FEATURES=1200
SMART_CITY_TILE_MAX_FEATURES=5000
SMART_CITY_TILE_MAX_ZOOM=16

# Local tests can force filesystem persistence by setting OPS_ACTION_LOG_PATH.
# OPS_ACTION_LOG_PATH=.local/smart-city-action-log.json
# OPS_COMMAND_LOG_PATH=.local/smart-city-command-log.json

# Optional upstream feeds. When unset, real-data-only mode leaves those layers
# empty and source health shows which connectors need setup.
SMART_CITY_BMA_FEED_URL=
SMART_CITY_ITIC_LIVE_EVENTS_URL=https://event.longdo.com/feed/json
SMART_CITY_ITIC_FEED_URL=
SMART_CITY_DATA_GOTH_API_KEY=
SMART_CITY_DATA_GOTH_RESOURCE_ID=

# Optional OSIRIS passive feed ingestion.
# Set to a running OSIRIS instance, for example https://osirisai.live or http://localhost:3000.
SMART_CITY_OSIRIS_BASE_URL=
SMART_CITY_OSIRIS_CCTV_REGION=asia
SMART_CITY_OSIRIS_TIMEOUT_MS=8000
SMART_CITY_OSIRIS_MAX_ROWS_PER_FEED=320
SMART_CITY_READ_MODEL_CACHE_TTL_MS=60000

# Optional Thai rail sources. When unset, the rail layer returns no rail cases
# and marks live rail connectors as needs_config.
SMART_CITY_RAIL_NEWS_FEED_URL=
SMART_CITY_RAIL_CROSSING_GEOJSON_URL=
SMART_CITY_SRT_TTS_INCIDENT_URL=https://ttsview.railway.co.th/ttsAPI/incident/data?slug=latest

# Official DRT/data.go.th rail baseline CSVs. Defaults are official DRT catalog
# URLs; override only when pinning a mirror or controlled internal copy.
SMART_CITY_DRT_CROSSING_CSV_URL=
SMART_CITY_DRT_CROSSING_ACCIDENTS_CSV_URL=
SMART_CITY_DRT_CROSSING_PLAN_CSV_URL=
